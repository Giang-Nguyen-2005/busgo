# Docker Compose only; Spring does not automatically load this file.
MYSQL_DATABASE=busgo_db
MYSQL_USER=busgo
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3307

# Export backend settings in your shell (or deployment secret store):
# DB_URL=jdbc:mysql://localhost:3307/busgo_db?connectionTimeZone=UTC
# DB_USERNAME=busgo
# DB_PASSWORD=<same application password as above>
# JWT_SECRET=<Base64 encoding of at least 32 random bytes>
# SERVER_PORT=8080
# SPRING_PROFILES_ACTIVE=dev,demo
# Use dev without demo for development; production excludes demo.
# JWT_ACCESS_TTL=1h
# JWT_REFRESH_TTL=7d

# frontend/.env.local (public build values; NEVER put secrets here):
# VITE_API_BASE_URL=/api/v1
# API_PROXY_TARGET=http://localhost:8080
# Production-like hosting requires a same-origin API reverse proxy.

# Optional transactional email (backend only). Disabled unless enabled + host + valid from.
# MAIL_ENABLED=false
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=
# MAIL_STARTTLS=true
# NOTIFICATION_DELIVERY_INTERVAL=PT1M
# NOTIFICATION_REMINDER_INTERVAL=PT5M
# NOTIFICATION_INITIAL_DELAY=PT1M
